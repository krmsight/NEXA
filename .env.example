# ============================================================
# NEXA — Neural EXecution Agent | Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# LiveKit credentials (get from https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project-xxxxx.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq AI API key (optional — only needed if LLM_PROVIDER = "groq")
GROQ_API_KEY=

# OpenAI API key (get from https://platform.openai.com/api-keys)
# Required for TTS (OpenAI nova) and Whisper STT
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxx

# Deepgram API key (optional — get from https://console.deepgram.com)
DEEPGRAM_API_KEY=

# Google API key — required if LLM_PROVIDER = "gemini" (get from https://aistudio.google.com/projects)
GOOGLE_API_KEY=your-google-api-key

# Google Cloud credentials — only for STT_PROVIDER = "google"
# Option 1: path to a service-account JSON file (download from GCP Console → IAM → Service Accounts)
# Option 2: leave blank and run: gcloud auth application-default login
GOOGLE_APPLICATION_CREDENTIALS=

# Supabase configuration (optional — for the ticketing tool)
SUPABASE_URL=https://your-project-id.supabase.co/rest/v1
SUPABASE_API_KEY=your-supabase-api-key

# MCP server identity (optional — defaults to "NEXA")
SERVER_NAME=NEXA

# Set to "true" to enable verbose debug logging
DEBUG=false
